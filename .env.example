# PromptLayer API Key
# Get your API key from https://promptlayer.com
PROMPTLAYER_API_KEY=pl_your_api_key_here

# Optional: Override the API base URL.
# Defaults to https://api.promptlayer.com when unset.
# Set this when pointing the MCP server at a self-hosted PromptLayer instance.
# Use the API domain of your instance, not the web interface domain.
# PROMPTLAYER_BASE_URL=https://api.promptlayer.your-company.example.com
