{
  "name": "@promptlayer/mcp-server",
  "version": "1.18.4",
  "description": "Model Context Protocol server for PromptLayer",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "promptlayer-mcp": "build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "promptlayer",
    "prompt-management"
  ],
  "author": "PromptLayer",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "hono": "^4.12.18",
    "@hono/node-server": "^1.19.13",
    "express-rate-limit": "^8.2.2",
    "path-to-regexp": "^8.4.0",
    "qs": "^6.15.2",
    "ajv": "^8.18.0",
    "fast-uri": "^3.1.2",
    "ip-address": "^10.1.1"
  }
}
